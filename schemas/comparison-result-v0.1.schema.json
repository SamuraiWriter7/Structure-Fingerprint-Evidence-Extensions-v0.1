{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazene.example/specs/comparison-result-v0.1.schema.json",
  "title": "Comparison Result v0.1",
  "description": "A minimal machine-readable object for comparing two Structure Fingerprint records while separating proof-oriented and inference-oriented evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "inputs",
    "method",
    "proof_comparison",
    "inference_comparison",
    "result",
    "uncertainty",
    "review",
    "policy"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "proof_comparison": {
      "$ref": "#/$defs/proof_comparison"
    },
    "inference_comparison": {
      "$ref": "#/$defs/inference_comparison"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "uncertainty": {
      "$ref": "#/$defs/uncertainty"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "inputs": {
            "properties": {
              "input_binding_mode": {
                "const": "unresolved_reference"
              }
            },
            "required": [
              "input_binding_mode"
            ]
          }
        },
        "required": [
          "inputs"
        ]
      },
      "then": {
        "properties": {
          "uncertainty": {
            "properties": {
              "ambiguity_level": {
                "enum": [
                  "medium",
                  "high",
                  "unresolved"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "properties": {
              "comparison_class": {
                "enum": [
                  "equivalent",
                  "near_equivalent",
                  "conflicting",
                  "inconclusive"
                ]
              }
            },
            "required": [
              "comparison_class"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "human_review_required": {
                "const": true
              }
            },
            "required": [
              "human_review_required"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "type": {
          "type": "string",
          "enum": [
            "human",
            "ai_agent",
            "software_tool",
            "hybrid_system"
          ]
        }
      }
    },
    "fingerprint_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint_id",
        "uri",
        "spec_version"
      ],
      "properties": {
        "fingerprint_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "uri": {
          "$ref": "#/$defs/uri"
        },
        "spec_version": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_id",
        "spec_version",
        "created_at",
        "producer"
      ],
      "properties": {
        "comparison_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "spec_version": {
          "const": "0.1.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_fingerprint",
        "right_fingerprint",
        "input_binding_mode"
      ],
      "properties": {
        "left_fingerprint": {
          "$ref": "#/$defs/fingerprint_ref"
        },
        "right_fingerprint": {
          "$ref": "#/$defs/fingerprint_ref"
        },
        "input_binding_mode": {
          "type": "string",
          "enum": [
            "uri_reference",
            "embedded_snapshot",
            "hash_bound_reference",
            "unresolved_reference"
          ]
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "method_version",
        "compared_namespaces",
        "weighting_profile"
      ],
      "properties": {
        "method_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "method_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "compared_namespaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "meta",
              "canon",
              "proof",
              "inference",
              "risk"
            ]
          }
        },
        "weighting_profile": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "meta": {
              "$ref": "#/$defs/score"
            },
            "canon": {
              "$ref": "#/$defs/score"
            },
            "proof": {
              "$ref": "#/$defs/score"
            },
            "inference": {
              "$ref": "#/$defs/score"
            },
            "risk": {
              "$ref": "#/$defs/score"
            }
          }
        },
        "normalization_profile": {
          "type": "string"
        }
      }
    },
    "proof_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "score",
        "matched_fields",
        "conflicting_fields"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "strong_match",
            "partial_match",
            "no_match",
            "conflict",
            "unavailable",
            "not_applicable"
          ]
        },
        "score": {
          "$ref": "#/$defs/score"
        },
        "matched_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicting_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "inference_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_flow",
        "concept_graph",
        "discourse_pattern",
        "stylistic_pattern"
      ],
      "properties": {
        "structural_flow": {
          "$ref": "#/$defs/score"
        },
        "concept_graph": {
          "$ref": "#/$defs/score"
        },
        "discourse_pattern": {
          "$ref": "#/$defs/score"
        },
        "stylistic_pattern": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "inference_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "overall_score",
        "dimensions"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "strong_similarity",
            "moderate_similarity",
            "weak_similarity",
            "no_similarity",
            "conflict",
            "insufficient_evidence"
          ]
        },
        "overall_score": {
          "$ref": "#/$defs/score"
        },
        "dimensions": {
          "$ref": "#/$defs/inference_dimensions"
        },
        "matched_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "divergent_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_similarity",
        "comparison_class",
        "conflict_flags"
      ],
      "properties": {
        "overall_similarity": {
          "$ref": "#/$defs/score"
        },
        "comparison_class": {
          "type": "string",
          "enum": [
            "equivalent",
            "near_equivalent",
            "structurally_related",
            "weakly_related",
            "unrelated",
            "conflicting",
            "inconclusive"
          ]
        },
        "conflict_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "proof_conflict",
              "inference_conflict",
              "timestamp_conflict",
              "provenance_conflict",
              "normalization_conflict",
              "risk_conflict",
              "insufficient_data"
            ]
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "missing_fields",
        "ambiguity_level"
      ],
      "properties": {
        "confidence": {
          "$ref": "#/$defs/score"
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguity_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "unresolved"
          ]
        },
        "uncertainty_notes": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_review_required",
        "review_reason"
      ],
      "properties": {
        "human_review_required": {
          "type": "boolean"
        },
        "review_reason": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "high_similarity",
              "proof_conflict",
              "inference_conflict",
              "allocation_sensitive",
              "authorship_sensitive",
              "legal_sensitive",
              "insufficient_evidence",
              "policy_required"
            ]
          }
        },
        "recommended_review_type": {
          "type": "string",
          "enum": [
            "none",
            "technical_review",
            "editorial_review",
            "provenance_review",
            "legal_review",
            "allocation_review",
            "multi_wing_review"
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_downstream_uses",
        "prohibited_downstream_uses"
      ],
      "properties": {
        "allowed_downstream_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "lineage_input",
              "dispute_input",
              "audit_input",
              "allocation_readiness_input",
              "ranking_input",
              "research_input",
              "human_review_input"
            ]
          }
        },
        "prohibited_downstream_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "automatic_authorship_claim",
              "automatic_origin_claim",
              "automatic_royalty_assignment",
              "automatic_legal_claim",
              "irreversible_enforcement"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "automatic_authorship_claim"
              },
              "minContains": 1
            },
            {
              "contains": {
                "const": "automatic_origin_claim"
              },
              "minContains": 1
            },
            {
              "contains": {
                "const": "automatic_royalty_assignment"
              },
              "minContains": 1
            },
            {
              "contains": {
                "const": "automatic_legal_claim"
              },
              "minContains": 1
            }
          ]
        },
        "policy_notes": {
          "type": "string"
        }
      }
    }
  }
}
